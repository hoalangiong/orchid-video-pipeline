    tips: [
      { label: "Điều 1", title: "Vì sao chúng kích rễ", desc: "Nước vo gạo chứa vitamin nhóm B và tinh bột, vỏ chuối giàu kali và lân, đều là những thứ giúp cây bật rễ, mập rễ. Nhưng nhớ, đây chỉ là chất bổ trợ nhẹ, không thay thế hoàn toàn phân, và tuyệt đối phải dùng loãng." },
      { label: "Điều 2", title: "Cách làm đúng", desc: "Nước vo gạo phải để lắng hoặc ngâm cho lên men nhẹ vài ngày rồi pha thật loãng với nước sạch. Vỏ chuối nên ngâm ủ loãng chứ đừng đắp trực tiếp lên gốc. Đắp nguyên vỏ chuối tươi lên gốc là cách nhanh nhất rước kiến, nấm mốc và thối rễ." },
      { label: "Điều 3", title: "Tưới đúng liều", desc: "Chỉ tưới loại nước này mỗi tuần một lần, phun vào rễ và giá thể lúc chiều mát, tránh xịt đọng trên ngọn và lá non. Loãng và thưa thì cây hấp thu tốt. Đặc và dày đặc là môi trường cho nấm khuẩn phát triển, phản tác dụng ngay." },
      { label: "Điều 4", title: "Kết hợp thoáng gió", desc: "Sau khi tưới, cây phải được đặt nơi thoáng gió cho nhanh khô ráo. Ẩm mà bí là thối. Kết hợp nước vo gạo, chuối loãng với giá thể thoáng và gió tốt, vài tuần sau bạn sẽ thấy đầu rễ trắng xanh bật ra khỏe mạnh." },
    ],
    outroText: "Nước vo gạo và chuối kích rễ rất tốt, nhưng phải ủ loãng,\ntưới thưa và giữ thoáng gió. Dùng đúng thì rễ bật trắng nõn.\nBạn từng kích rễ lan bằng mẹo này chưa? Comment nhé! 👇",
  },
  {
    slug: "khongrahoa",
    hideProduct: true,
    colors: { accent: "#e0a838", gold: "#ffe39a", sub: "#fff2cf", badgeText: "#2e2200", bg: "#12160a", gradient: "18,22,10" },
    scenes: { title: 413, tip1: 438, tip2: 449, tip3: 423, tip4: 438, outro: 375 },
    titleText: "TỐT LÁ MÀ\nMÃI KHÔNG RA HOA",
    subText: "Xanh mướt, đâm chồi ầm ầm mà chẳng thấy một nụ 🌿",
    tips: [
      { label: "Lý do 1", title: "Thiếu nắng", desc: "Đây là nguyên nhân số một. Lan để chỗ râm quá, lá xanh đậm mềm và mỏng, cây tốt lá nhưng không tích đủ năng lượng để làm hoa. Muốn ra hoa, hầu hết các loại lan đều cần nắng sáng mạnh nhưng tán xạ qua một lớp lưới." },
      { label: "Lý do 2", title: "Bón thừa đạm", desc: "Phân nhiều đạm giúp cây xanh tốt, ra lá ra keiki liên tục, nhưng chính nó ức chế việc làm hoa. Cây cứ mải nuôi thân lá mà quên ra nụ. Khi thân đã trưởng thành, phải giảm đạm và tăng lân kali thì cây mới chuyển sang làm hoa." },
      { label: "Lý do 3", title: "Cây chưa trưởng thành", desc: "Lan chỉ ra hoa khi thân, giả hành đã mập và chín. Nếu cứ thay chậu, tách chiết liên tục, cây phải lo hồi sức mãi, không bao giờ đủ sức làm hoa. Hãy để cây yên cho bụi lớn và thân chín tự nhiên." },
      { label: "Lý do 4", title: "Thiếu kích thích ra hoa", desc: "Nhiều loại lan cần một cú hích mới bung nụ, đó là chênh lệch nhiệt ngày đêm hoặc một mùa khô nghỉ ngắn. Nếu quanh năm bạn tưới đều, nhiệt độ không đổi, cây không nhận được tín hiệu để làm hoa. Hãy tạo cho cây một khoảng nghỉ." },
    ],
    outroText: "Đủ nắng, giảm đạm tăng lân kali, để cây trưởng thành\nrồi tạo cú hích ra hoa, khắc phục cảnh tốt lá mà mãi không nụ.\nLan nhà bạn tốt lá nhưng chưa ra hoa? Comment nhé! 👇",
  },
  {
    slug: "gheplan",
