    hideProduct: true,
    colors: { accent: "#3a9ad9", gold: "#a3d6ff", sub: "#ddeeff", badgeText: "#062435", bg: "#0a161c", gradient: "10,22,28" },
    scenes: { title: 411, tip1: 461, tip2: 456, tip3: 474, tip4: 421, outro: 398 },
    titleText: "BỐ TRÍ GIÀN LAN\nBAN CÔNG SÂN THƯỢNG",
    subText: "Ban công chật vẫn sai hoa, sân thượng rộng lại còi, khác ở đâu? 🏙️",
    tips: [
      { label: "Điều 1", title: "Ưu tiên độ thoáng", desc: "Lan sợ nhất là bí và ẩm đọng. Treo cây cách nhau đủ rộng cho gió luồn qua, đừng nhồi nhét kín giàn. Không gian nhỏ thì treo thành nhiều tầng cao thấp, chừa lối cho không khí lưu thông. Thoáng gió là nửa phần thắng khi trồng lan." },
      { label: "Điều 2", title: "Đón nắng đúng hướng", desc: "Quan sát nắng cả ngày, hướng đông có nắng sáng dịu là lý tưởng, hướng tây nắng chiều gắt cần che bớt. Xếp cây ưa nắng ra ngoài, cây ưa mát vào trong hoặc tầng dưới. Bố trí theo nhu cầu ánh sáng của từng loại là cây nào cũng đủ nắng." },
      { label: "Điều 3", title: "Tận dụng chiều cao", desc: "Ban công, sân thượng nhỏ thì trồng theo chiều đứng. Làm giàn nhiều tầng, treo dọc theo lan can, hay gắn lên tường lưới. Cây ưa nắng và thân thòng treo trên cao, chậu ưa ẩm mát đặt tầng dưới. Vừa gọn, vừa cho mỗi cây đúng vi khí hậu." },
      { label: "Điều 4", title: "Giữ ẩm không úng", desc: "Không gian bê tông thường khô nóng và hắt nhiệt. Đặt một khay nước hoặc tưới nền cho mát ẩm không khí, nhưng phải kê chậu cao cho thoát nước tốt, đừng để đọng. Sàn thoát nước tốt, không khí ẩm mát là lan trên ban công vẫn sung." },
    ],
    outroText: "Treo thưa cho thoáng, đón nắng đúng hướng, tận dụng chiều cao,\ngiữ ẩm mà không úng là ban công nhỏ vẫn thành vườn lan sai hoa.\nBạn trồng lan ở ban công hay sân thượng? Comment nhé! 👇",
  },
  {
    slug: "sangchau",
    hideProduct: true,
    colors: { accent: "#4aa88a", gold: "#a8e6d0", sub: "#ddf5ec", badgeText: "#052a20", bg: "#0a1c16", gradient: "10,28,22" },
    scenes: { title: 420, tip1: 450, tip2: 484, tip3: 474, tip4: 473, outro: 412 },
    titleText: "SANG CHẬU LAN\nKHÔNG LÀM CÂY SUY",
    subText: "Cây đang khỏe, sang chậu xong héo rũ thối rễ, sai ở đâu? 🌿",
    tips: [
      { label: "Điều 1", title: "Chọn đúng thời điểm", desc: "Chỉ sang chậu khi cây vừa qua đợt hoa và bắt đầu nhú rễ mới, mầm mới ở gốc. Đó là lúc cây đang sung sức nhất, sang chậu xong bén rễ rất nhanh. Tránh sang lúc cây đang ra hoa hay đang nghỉ, cây dễ sốc và chững lại." },
      { label: "Điều 2", title: "Gỡ cây thật nhẹ", desc: "Trước khi gỡ, tưới ẩm cho giá thể mềm ra, rễ bớt giòn. Nhẹ nhàng tách rễ khỏi thành chậu, đừng giật mạnh kẻo đứt rễ. Rễ lan rất giòn, mỗi cọng rễ đứt là cây mất một phần sức. Kiên nhẫn gỡ từ từ là giữ được bộ rễ." },
      { label: "Điều 3", title: "Cắt tỉa và sát trùng", desc: "Sau khi gỡ, cắt bỏ rễ khô, rễ thối đen, lá vàng úa bằng kéo đã khử trùng. Bôi vôi hoặc keo liền sẹo vào vết cắt cho khỏi nhiễm nấm khuẩn. Chỉ giữ lại rễ trắng xanh còn khỏe. Dọn sạch trước khi vào chậu mới là cây an toàn." },
      { label: "Điều 4", title: "Vào chậu mới đúng cách", desc: "Chọn chậu và giá thể thật thoáng, thoát nước tốt. Đặt gốc cây vững, hướng mầm non ra ngoài để có chỗ phát triển. Cố định cây cho khỏi lung lay. Xong đưa vào chỗ mát, thoáng gió, giữ ẩm và ngưng phân vài tuần cho cây bén rễ đã." },
    ],
    outroText: "Sang chậu đúng lúc cây nhú rễ mới, gỡ nhẹ giữ rễ,\ncắt tỉa sát trùng rồi vào giá thể thoáng và dưỡng mát vài tuần.\nBạn hay sang chậu lan vào lúc nào? Comment nhé! 👇",
  },
  {
    slug: "teogiahanh",
    hideProduct: true,
    colors: { accent: "#7fb04a", gold: "#cfe8a3", sub: "#eef7dd", badgeText: "#1f2c08", bg: "#141c0a", gradient: "20,28,10" },
    scenes: { title: 411, tip1: 474, tip2: 461, tip3: 460, tip4: 498, outro: 419 },
    titleText: "CỨU LAN TEO GIẢ HÀNH\nCHO MẬP LẠI",
    subText: "Tưới hoài mà giả hành cứ teo, lá nhăn nheo, lỗi nằm ở đâu? 🌱",
    tips: [
      { label: "Điều 1", title: "Tìm đúng nguyên nhân", desc: "Giả hành teo, lá nhăn gần như luôn do bộ rễ hỏng, thối vì úng nước hay giá thể mục bí. Rễ chết thì cây không hút được nước, càng tưới nhiều càng úng thêm. Nhận đúng bệnh ở rễ, đừng cứ thấy nhăn là tưới, mới chữa được tận gốc." },
      { label: "Điều 2", title: "Kiểm tra và xử lý rễ", desc: "Nhấc cây ra khỏi chậu, gỡ hết giá thể cũ. Cắt bỏ rễ khô, rễ thối đen bằng kéo đã khử trùng, chỉ giữ lại rễ trắng xanh còn sống. Bôi keo liền sẹo vào vết cắt cho khỏi nhiễm nấm. Bộ rễ sạch bệnh là nền tảng để cây hồi lại." },
      { label: "Điều 3", title: "Trồng lại và kích rễ", desc: "Ghép cây lên giá thể mới thật thoáng, thoát nước tốt như dớn hay than vỏ thông. Cố định cho cây khỏi lung lay, phun thuốc kích rễ loãng để đánh thức mầm rễ mới. Giá thể thoáng và ẩm nhẹ là điều kiện để rễ non bung ra." },
      { label: "Điều 4", title: "Dưỡng phục hồi kiên nhẫn", desc: "Treo cây chỗ mát, thoáng gió, che bớt nắng gắt. Giai đoạn này tưới vừa phải, giữ ẩm chứ đừng sũng nước, và chưa bón phân đậm. Khi thấy rễ mới đâm ra và giả hành căng dần thì mới tăng dinh dưỡng loãng. Cứ từ tốn, cây sẽ mập lại." },
    ],
    outroText: "Bắt đúng bệnh ở rễ, cắt bỏ rễ thối, trồng lại giá thể thoáng\nrồi dưỡng ẩm mát và kiên nhẫn là cây teo tóp sẽ bung rễ mới, mập lại.\nCây của bạn có bị teo giả hành chưa? Comment nhé! 👇",
  },
  {
    slug: "rungnu",
    hideProduct: true,
    colors: { accent: "#d95f8a", gold: "#ffb3cd", sub: "#ffe0ec", badgeText: "#3a0a1c", bg: "#1c0a14", gradient: "28,10,20" },
    scenes: { title: 407, tip1: 472, tip2: 502, tip3: 481, tip4: 489, outro: 389 },
    titleText: "GIỮ NỤ CHO LAN\nNỞ TRỌN CẢ VÒI",
    subText: "Nụ căng mọng bỗng vàng rụng sạch trước khi nở, tại sao? 🌸",
    tips: [
      { label: "Điều 1", title: "Tránh sốc nhiệt", desc: "Lúc đang nuôi nụ, đừng bê cây từ chỗ mát ra nắng gắt, hay từ trong nhà ra ngoài trời lạnh. Chênh lệch nhiệt độ ngày đêm quá lớn là cây bị sốc, buông nụ ngay. Giữ cây ở một chỗ ổn định, che chắn khi trở trời là an toàn nhất." },
      { label: "Điều 2", title: "Giữ ẩm ổn định", desc: "Giai đoạn nuôi nụ cây rất nhạy, để khô hạn đột ngột rồi lại tưới đẫm là nụ teo và rụng. Tưới đều đặn, giữ giá thể ẩm vừa phải, đừng lúc khô lúc sũng. Độ ẩm không khí quanh cây cũng nên cao một chút. Ẩm ổn định là nụ giữ được đến ngày bung." },
      { label: "Điều 3", title: "Tránh khí ga, trái chín", desc: "Ít ai để ý, nhưng khói bếp, khí ga và nhất là hơi từ trái cây chín có chất ê ti len làm nụ vàng rụng hàng loạt. Đừng đặt chậu lan đang có nụ gần bếp, gần chỗ để trái cây hay chỗ hun khói. Để cây nơi thoáng khí sạch là giữ được nụ." },
      { label: "Điều 4", title: "Đủ sáng, đừng xê dịch", desc: "Cho cây đủ ánh sáng dịu để nụ phát triển, bón phân loãng giàu lân kali để nuôi hoa, tránh đạm cao. Và khi vòi đã ra nụ thì đừng xoay hay dời chậu liên tục, cây định hướng lại cũng dễ rụng nụ. Cứ để yên là hoa nở đều." },
    ],
    outroText: "Tránh sốc nhiệt, giữ ẩm ổn định, tránh xa khí ga trái chín\nvà để cây yên một chỗ đủ sáng là giữ trọn nụ, nở bung cả vòi hoa.\nBạn từng bị lan rụng nụ oan chưa? Comment nhé! 👇",
  },
  {
    slug: "thuanrung",
