    scenes: { title: 454, tip1: 521, tip2: 520, tip3: 543, tip4: 533, outro: 404 },
    titleText: "NƯỚC MÁY CÓ HẠI LAN?\nSỰ THẬT KHIẾN BẠN NHẸ LÒNG",
    subText: "Đừng hì hục hứng nước mưa khi vòi nước ngay bên cạnh 💧",
    tips: [
