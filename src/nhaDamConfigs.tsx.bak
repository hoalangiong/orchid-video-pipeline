    tips: [
      { label: "Điều 1", title: "Giảm hẳn lượng nước tưới", desc: "Mùa đông cây gần như ngừng sinh trưởng, hút nước rất ít, nếu bạn vẫn tưới đều như mùa hè thì giá thể ẩm lâu, gốc rễ dễ thối nhũn. Hãy giãn cữ tưới ra, chỉ tưới khi giá thể đã khô, và tưới vào buổi sáng nắng ấm để cây kịp ráo trước đêm lạnh. Ít nước lại chính là cứu cây." },
      { label: "Điều 2", title: "Giữ ấm và chắn gió lạnh", desc: "Gió mùa và sương giá là kẻ thù của lan. Hãy che chắn giàn bằng bạt, nilon quanh hướng gió, hoặc chuyển chậu vào nơi kín gió, hiên nhà, sát tường ấm. Tránh để cây phơi trực tiếp trong gió buốt và sương đêm. Giữ được hơi ấm quanh gốc là cây bớt sốc lạnh, không rụng lá hàng loạt." },
      { label: "Điều 3", title: "Ngưng đạm, tăng kali", desc: "Mùa lạnh cây nghỉ, bón đạm mạnh chỉ ép cây ra mầm non yếu ớt, gặp rét là hỏng ngay. Hãy ngưng hoặc giảm hẳn phân, nếu có bón thì ưu tiên loại giàu kali để cây cứng cáp, tăng sức chịu lạnh. Để cây được nghỉ ngơi đúng nhịp tự nhiên, đừng ép nó lớn giữa mùa đông." },
      { label: "Điều 4", title: "Tận dụng nắng và phòng nấm", desc: "Những ngày hửng nắng, hãy cho lan tắm nắng ấm buổi sáng để cây quang hợp, khô thoáng, hạn chế nấm bệnh phát sinh trong tiết ẩm lạnh. Giữ giàn thông thoáng, dọn lá úa, có thể phun phòng nấm định kỳ. Nắng ấm và sự khô ráo chính là liều thuốc bổ tự nhiên giúp lan vượt đông." },
    ],
    outroText: "Giảm hẳn nước tưới, che chắn giữ ấm chắn gió, ngưng đạm tăng\nkali và tận dụng nắng phòng nấm. Làm vậy là lan vượt qua mùa đông an toàn, chờ xuân bung lộc.\nVườn lan nhà bạn có bị suy vào mùa lạnh không? Comment cho mình biết nhé 👇",
  },
  {
    slug: "denled",
    hideProduct: true,
    colors: { accent: "#b06bd8", gold: "#dca8f4", sub: "#f0e2fa", badgeText: "#2c0d3a", bg: "#170a20", gradient: "23,10,32" },
    scenes: { title: 440, tip1: 552, tip2: 537, tip3: 551, tip4: 527, outro: 426 },
    titleText: "DÙNG ĐÈN LED NUÔI LAN\nNƠI THIẾU SÁNG",
    subText: "Ban công thiếu nắng vẫn có giàn lan xanh tốt nở hoa 💡",
    tips: [
      { label: "Điều 1", title: "Khi nào cần tới đèn LED", desc: "Nếu chỗ bạn nắng yếu, chỉ vài giờ hoặc gần như không có nắng trực tiếp, lan sẽ vống, lá xanh mướt nhưng yếu, khó ra hoa. Đó là lúc đèn LED trồng cây phát huy tác dụng, bổ sung ánh sáng cây cần để quang hợp và làm nụ. Đèn không thay hẳn mặt trời, nhưng là cứu cánh cho nơi thiếu nắng." },
      { label: "Điều 2", title: "Chọn đúng loại đèn full spectrum", desc: "Hãy dùng đèn LED chuyên trồng cây, loại full spectrum, tức phổ đầy đủ, chứ không phải đèn chiếu sáng thường. Đèn full spectrum cho dải sáng gần với ánh nắng, đủ cả bước sóng cây cần để lớn và ra hoa. Chọn công suất phù hợp số lượng cây, ưu tiên hãng uy tín để bền và an toàn điện." },
      { label: "Điều 3", title: "Đặt đúng khoảng cách và thời lượng", desc: "Treo đèn cách ngọn cây tầm hai tới bốn tấc, gần quá dễ cháy lá, xa quá thì yếu. Mỗi ngày chiếu khoảng mười tới mười hai tiếng là đủ, nên cắm hẹn giờ tự động cho đều và tiết kiệm điện. Quan sát cây, nếu lá cháy hay vươn dài bất thường thì chỉnh lại khoảng cách và thời gian." },
      { label: "Điều 4", title: "Kết hợp chăm sóc cho cây khỏe", desc: "Có đèn rồi vẫn phải chăm đúng, giữ thông thoáng, tưới và bón hợp lý, vì ánh sáng chỉ là một yếu tố. Nơi trong nhà thường bí gió nên chú ý quạt nhẹ cho thoáng, tránh nấm. Kết hợp đèn tốt với chăm khéo thì lan trong nhà vẫn mập mạp, lên mầm đều và cho hoa như thường." },
    ],
    outroText: "Biết khi nào cần đèn, chọn đúng đèn full spectrum, đặt đúng\nkhoảng cách thời lượng và kết hợp chăm sóc thông thoáng. Làm vậy là ban công thiếu nắng vẫn có giàn lan xanh tốt.\nBạn có đang trồng lan trong nhà thiếu nắng không? Comment cho mình biết nhé 👇",
  },
  {
    slug: "tachchiet",
    hideProduct: true,
    colors: { accent: "#4faf7a", gold: "#93e6b6", sub: "#dcf6e7", badgeText: "#0a3020", bg: "#081f15", gradient: "8,31,21" },
    scenes: { title: 438, tip1: 574, tip2: 533, tip3: 547, tip4: 576, outro: 435 },
    titleText: "TÁCH CHIẾT NHÂN GIỐNG LAN\nTẠI NHÀ, 1 CÂY THÀNH NHIỀU",
    subText: "Từ một cây mẹ khỏe nhân ra cả chục cây con, không tốn đồng nào 🌱",
    tips: [
      { label: "Điều 1", title: "Chọn đúng cây và đúng thời điểm", desc: "Hãy chọn giò lan mẹ đã lớn, nhiều giả hành, thân mập khỏe, không sâu bệnh. Thời điểm tốt nhất để tách là sau khi cây tàn hoa, đầu mùa mưa hoặc lúc cây chuẩn bị bật mầm mới, vì khi đó cây sung sức, tách xong hồi nhanh. Đừng tách lúc cây đang nụ hay đang yếu, sẽ chột cả mẹ lẫn con." },
      { label: "Điều 2", title: "Dụng cụ phải sạch và sắc", desc: "Dùng dao hoặc kéo thật bén, hơ qua lửa hoặc lau cồn để khử trùng trước khi cắt. Đây là bước nhiều người bỏ qua rồi cây nhiễm nấm khuẩn, thối cả cụm. Mỗi lần cắt sang cây khác nên khử trùng lại. Dụng cụ sạch và sắc giúp vết cắt ngọt, cây ít tổn thương và mau lành." },
      { label: "Điều 3", title: "Tách đúng cách, mỗi phần đủ sức sống", desc: "Nhẹ nhàng gỡ cây khỏi giá thể, quan sát rồi cắt sao cho mỗi phần tách ra có ít nhất hai đến ba giả hành kèm bộ rễ riêng. Đừng tách quá vụn, một hai giả hành lẻ sẽ yếu, khó nuôi. Sau khi cắt, bôi keo liền sẹo hoặc vôi, sơn móng tay vào vết cắt để chống nhiễm khuẩn." },
      { label: "Điều 4", title: "Dưỡng cây con sau tách", desc: "Ghép mỗi phần vào chậu hoặc bảng dớn mới, cố định cho chắc gốc để rễ không lung lay. Để cây nơi mát, thoáng gió, tránh nắng gắt và mưa dầm vài tuần đầu. Giai đoạn này chưa vội bón phân nặng, chỉ giữ ẩm nhẹ và có thể kích rễ. Khi thấy mầm và rễ mới nhú ra là cây đã bén, coi như thành công." },
    ],
    outroText: "Chọn cây mẹ khỏe đúng thời điểm, dụng cụ sạch và sắc, tách sao\nmỗi phần đủ giả hành và rễ, rồi dưỡng cây con nơi mát ẩm. Vậy là từ một giò lan bạn nhân được cả vườn.\nBạn đã dám tự tách chiết lan chưa? Comment cho mình biết nhé 👇",
  },
  {
    slug: "phunsuong",
    hideProduct: true,
    colors: { accent: "#3fa8b9", gold: "#8fdce8", sub: "#dcf2f6", badgeText: "#082e34", bg: "#081e22", gradient: "8,30,34" },
    scenes: { title: 420, tip1: 515, tip2: 538, tip3: 517, tip4: 566, outro: 393 },
    titleText: "CÓ NÊN PHUN SƯƠNG\nCHO LAN KHÔNG?",
    subText: "Ngày nào cũng phun sương tưởng chăm kỹ, ai ngờ đang hại cây 💦",
    tips: [
      { label: "Điều 1", title: "Phun sương không thay được tưới", desc: "Phun sương chỉ làm ẩm bề mặt lá và không khí quanh cây, chứ không đủ nước ngấm vào giá thể nuôi rễ. Nếu bạn chỉ phun sương mà tưởng đã tưới đủ thì rễ vẫn khát, cây suy dần. Phun sương là bổ trợ tạo độ ẩm, còn tưới đẫm cho ướt giá thể mới là bữa ăn chính của cây." },
      { label: "Điều 2", title: "Phun sương đúng lúc mới có lợi", desc: "Khi trời hanh khô, nắng nóng, độ ẩm thấp, phun sương nhẹ giúp cây mát, giảm sốc nhiệt, lá tươi hơn. Nên phun vào sáng sớm hoặc chiều mát để nước kịp bay bớt. Tuyệt đối tránh phun giữa trưa nắng gắt, giọt nước đọng như thấu kính dễ làm cháy lá, cũng đừng phun khi trời đã ẩm sẵn." },
      { label: "Điều 3", title: "Phun sương ban đêm là sai lầm", desc: "Ban đêm nhiệt độ hạ, nếu lá và ngọn cứ đọng nước ẩm suốt đêm thì nấm khuẩn phát triển, dễ thối ngọn, thối lá. Hãy phun lúc còn ban ngày để đến tối cây đã ráo. Giữ cho ngọn và nách lá khô thoáng qua đêm chính là cách phòng bệnh đơn giản mà nhiều người quên mất." },
      { label: "Điều 4", title: "Quan trọng hơn là thông thoáng", desc: "Nếu giàn bí gió, phun sương nhiều chỉ càng ủ bệnh. Ngược lại, giàn thoáng gió thì độ ẩm tự cân bằng, ít phải phun. Hãy ưu tiên đặt cây nơi có gió lùa nhẹ, treo thưa, và chỉ phun sương khi thật sự khô hạn. Thoáng gió cộng ẩm vừa phải mới là môi trường lan thích, chứ không phải phun càng nhiều càng tốt." },
    ],
    outroText: "Phun sương không thay tưới, chỉ phun lúc hanh khô ban ngày,\ntránh phun đêm và luôn giữ giàn thông thoáng. Hiểu vậy là bạn thôi phun sương vô tội vạ mà hại cây.\nBạn có hay phun sương cho lan mỗi ngày không? Comment cho mình biết nhé 👇",
  },
  {
    slug: "tuoisai",
