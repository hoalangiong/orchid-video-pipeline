    colors: { accent: "#c78a4a", gold: "#e8c187", sub: "#f6ead8", badgeText: "#33210a", bg: "#1a130a", gradient: "26,19,10" },
    scenes: { title: 407, tip1: 486, tip2: 514, tip3: 499, tip4: 515, outro: 416 },
    titleText: "CHỌN ĐÚNG GIÁ THỂ\nTRỒNG LAN",
    subText: "Cùng một cây, chọn sai giá thể là công chăm đổ bể hết 🪴",
    tips: [
      { label: "Điều 1", title: "Hiểu bản chất giá thể", desc: "Lan rừng đa phần là phong lan, rễ bám hờ và cần thở, ưa giá thể thật thoáng, thoát nước nhanh, giữ ẩm vừa phải chứ không sũng. Nhớ nguyên tắc thoáng gốc, ẩm mà không úng. Hiểu điều này rồi thì nhìn loại nào cũng biết nó hợp với rễ lan hay không." },
      { label: "Điều 2", title: "Dớn, vỏ thông cho đa số", desc: "Dớn vụn, dớn cọng giữ ẩm tốt, thoáng, hợp giả hạc, hoàng thảo, đai châu ưa ẩm. Vỏ thông và than gỗ thoát nước nhanh, bền, hợp cát lan, lan cần khô thoáng. Đây là bộ giá thể phổ thông, dễ kiếm, phù hợp phần lớn dòng lan trồng chậu." },
      { label: "Điều 3", title: "Gỗ lũa cho dòng khô thoáng", desc: "Những dòng rễ to, ưa khô ráo và muốn mọc tự nhiên buông thõng như đai châu, giả hạc thì ghép lên gỗ lũa, dớn bảng rất hợp. Ghép gỗ cây thoáng gốc tối đa, gần với môi trường rừng, tuy mau khô nên phải tưới nhiều hơn. Đổi lại rễ cực khỏe, ít bệnh." },
      { label: "Điều 4", title: "Tránh sai lầm, phối khéo", desc: "Đừng dùng giá thể quá bí, giữ nước như đất thịt hay xơ dừa nén chặt, gốc lan sẽ úng thối. Có thể trộn vài loại như than với vỏ thông, dớn để vừa thoáng vừa đủ ẩm. Và nhớ thay giá thể khi đã mục. Chọn và phối đúng là bộ rễ khỏe suốt vụ." },
    ],
    outroText: "Hiểu rễ lan cần thoáng, chọn dớn vỏ thông cho đa số,\ngỗ lũa cho dòng khô thoáng và tránh giá thể bí úng là bộ rễ bung khỏe.\nBạn đang trồng lan bằng giá thể gì? Comment nhé! 👇",
  },
  {
