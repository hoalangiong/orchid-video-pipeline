    scenes: { title: 372, tip1: 386, tip2: 363, tip3: 362, tip4: 318, outro: 218 },
    titleText: "CHỌN CHỖ TREO LAN\nĐÚNG CHUẨN Ở HIÊN NHÀ",
    subText: "Cùng một cây, treo sai chỗ là còi cọc, treo đúng là bung đọt 🪴",
    tips: [
      { label: "Điều 1", title: "Ưu tiên mép hiên nhiều sáng", desc: "Hãy treo lan ở mép hiên, nơi hứng nắng sớm dịu và sáng gián tiếp cả ngày. Tránh treo sâu vào trong hiên tối om, vì thiếu sáng lan sẽ vươn dài, yếu ớt và không chịu ra hoa. Lan cần sáng, chỉ là sáng vừa phải chứ không phải nắng gắt buổi trưa, nên mép hiên là vị trí lý tưởng nhất." },
      { label: "Điều 2", title: "Treo cao cho thoáng gốc", desc: "Nên treo cao ngang tầm mắt hoặc cao hơn, để gió luồn quanh gốc dễ dàng. Đừng treo sát tường hay sát trần vì hơi nóng hầm lại, bí gió, gốc dễ úng và sinh nấm. Thoáng gốc là nguyên tắc số một khi treo lan ở hiên, gốc càng thông thoáng thì rễ càng khỏe và ít bệnh." },
      { label: "Điều 3", title: "Tránh nước xối và gió máy", desc: "Tránh chỗ nước mưa xối thẳng từ mái hiên xuống, và tránh nơi máy lạnh, quạt thổi khô rát cả ngày. Nước dội mạnh làm dập mầm non, còn gió máy lạnh làm cháy mép lá. Hãy chọn góc yên gió mạnh trực tiếp nhưng vẫn thông thoáng tự nhiên, cây mới phát triển ổn định." },
      { label: "Điều 4", title: "Xoay chậu cho sáng đều", desc: "Nếu hiên chỉ sáng một bên, cứ vài tuần bạn xoay chậu một lần cho cây nhận sáng đều bốn phía. Nhờ vậy thân mọc thẳng, không nghiêng vẹo về phía sáng, dáng cây cân đối đẹp mắt. Một mẹo nhỏ nhưng giữ được form cây rất đẹp, nhất là với những giò lan trưng trong nhà." },
    ],
    outroText: "Treo ở mép hiên nhiều sáng, treo cao cho thoáng gốc, tránh\nnước xối gió máy và nhớ xoay chậu cho sáng đều. Chọn đúng chỗ treo là nửa đường thành công rồi.\nBạn đang treo lan ở hiên hướng nào? Comment cho mình biết nhé 👇",
  },
  {
    slug: "hienhuong",
    hideProduct: true,
    colors: { accent: "#e0a53c", gold: "#f6d488", sub: "#faeed2", badgeText: "#3a2a08", bg: "#241a06", gradient: "36,26,6" },
    scenes: { title: 362, tip1: 378, tip2: 402, tip3: 371, tip4: 334, outro: 219 },
    titleText: "HIÊN NHÀ HƯỚNG NÀO\nHỢP TRỒNG LAN?",
    subText: "Cùng một cây, hướng này bung hoa, hướng kia lụi dần ☀️",
    tips: [
      { label: "Hướng Đông", title: "Nắng sớm dịu, lý tưởng nhất", desc: "Hiên hướng Đông đón nắng sớm dịu mát rồi tắt nắng trước trưa. Đây là hướng lý tưởng cho hầu hết các dòng lan, từ giả hạc, hoàng thảo tới cát lan. Nắng sáng đủ để kích hoa mà không làm cháy lá, nên người mới chơi lan nên ưu tiên treo lan ở hiên hướng này cho chắc ăn." },
      { label: "Hướng Tây", title: "Nắng gắt, phải che lưới", desc: "Hiên hướng Tây nắng gắt buổi chiều, nóng và hanh khô. Hướng này chỉ hợp dòng chịu nắng như cát lan, đai châu, và bắt buộc phải che thêm lưới. Nếu không che, lá vàng cháy rất nhanh. Hướng Tây chăm cực hơn, nhưng bù lại những cây ưa nắng lại lên màu lá và màu hoa rất đẹp." },
      { label: "Nam và Bắc", title: "Nam sáng đều, Bắc nhiều bóng", desc: "Hiên hướng Nam sáng đều cả ngày, ổn định, trồng dòng gì cũng khá ổn. Còn hiên hướng Bắc mát và thiếu nắng nhất, chỉ hợp dòng chịu bóng như hồ điệp, lan hài. Dòng ưa nắng mà để hướng Bắc sẽ tốt lá nhưng không chịu ra hoa, nên phải chọn cây theo đúng đặc điểm từng hướng." },
      { label: "Lời khuyên", title: "Chọn cây theo hướng có sẵn", desc: "Đừng cố ép một dòng lan vào hướng không hợp với nó. Thay vì vật lộn che chắn tốn công, hãy chọn cây theo hướng hiên nhà bạn đang có sẵn. Chọn đúng ngay từ đầu, bạn sẽ tiết kiệm được rất nhiều công chăm về sau, mà cây vẫn khỏe và sai hoa đều đặn mỗi mùa." },
    ],
    outroText: "Hướng Đông nắng dịu lý tưởng, hướng Tây phải che lưới, Nam\nsáng đều còn Bắc hợp dòng chịu bóng. Hiểu hướng hiên là chọn được cây hợp, chăm nhàn mà sai hoa.\nHiên nhà bạn quay hướng nào? Comment để mình gợi ý dòng lan nhé 👇",
  },
  {
    slug: "hienanhsang",
    hideProduct: true,
    colors: { accent: "#c9a63c", gold: "#f0da84", sub: "#f8f0d4", badgeText: "#332808", bg: "#1e1806", gradient: "30,24,6" },
    scenes: { title: 348, tip1: 359, tip2: 392, tip3: 376, tip4: 364, outro: 215 },
    titleText: "LAN HIÊN NHÀ THIẾU SÁNG\nMÃI KHÔNG RA HOA",
    subText: "Mái hiên che mất nắng, cây tốt lá mà chẳng thấy một nụ 🌿",
    tips: [
      { label: "Điều 1", title: "Nhận biết cây thiếu sáng", desc: "Dấu hiệu lan thiếu sáng rất dễ nhận ra. Lá xanh đậm bất thường, mềm và mỏng, thân vươn dài lêu nghêu hướng ra ngoài để tìm sáng, và tuyệt nhiên không có nụ hoa nào. Nếu cây nhà bạn đang như vậy, gần như chắc chắn góc treo hiện tại đang quá tối, cần xử lý ngay." },
      { label: "Điều 2", title: "Dời cây ra sát mép hiên", desc: "Cách đơn giản nhất là dời cây ra sát mép hiên, nơi hứng được nhiều sáng trời nhất dù không có nắng chiếu trực tiếp. Chỉ cần dịch ra vài chục phân thôi, lượng sáng cây nhận được đã khác hẳn. Nguyên tắc là ưu tiên chỗ nào nhìn thấy nhiều khoảng trời nhất thì đặt cây ở đó." },
      { label: "Điều 3", title: "Bổ sung đèn led trồng cây", desc: "Nếu hiên quá kín, hãy tận dụng đèn led trồng cây loại full spectrum. Treo đèn cách ngọn cây khoảng ba tấc, bật tám đến mười tiếng vào ban ngày. Ánh sáng đèn sẽ bù đắp phần nắng còn thiếu, giúp cây quang hợp đủ để tích lũy năng lượng làm nụ, rất hợp cho hiên nhà phố ít sáng." },
      { label: "Điều 4", title: "Sáng phải kèm thoáng gió", desc: "Sáng phải đi kèm thoáng gió mới thật sự hiệu quả. Một góc hiên dù sáng nhưng bí gió vẫn khiến cây yếu và dễ bệnh. Hãy kết hợp cho cây ra chỗ sáng, đồng thời có thêm chút gió tự nhiên luân chuyển. Sau vài tuần, thân cây sẽ mập lại và bắt đầu nhú những mắt hoa đầu tiên." },
    ],
    outroText: "Nhận biết cây thiếu sáng, dời ra mép hiên, bổ sung đèn led\nnếu cần và nhớ kèm thoáng gió. Đủ sáng là lan hiên nhà chịu ra hoa ngay.\nBạn định dời cây hay lắp đèn led? Comment cho mình biết nhé 👇",
  },
  {
    slug: "hienmua",
    hideProduct: true,
    colors: { accent: "#4a86c9", gold: "#9fc8ef", sub: "#dcecfa", badgeText: "#06223a", bg: "#0a1622", gradient: "10,22,34" },
    scenes: { title: 369, tip1: 377, tip2: 322, tip3: 334, tip4: 360, outro: 248 },
    titleText: "CHĂM LAN HIÊN NHÀ\nMÙA MƯA KHÔNG LO THỐI",
    subText: "Tưởng có mái che là an toàn, hóa ra mùa mưa mới dễ chết nhất 🌧️",
    tips: [
      { label: "Điều 1", title: "Coi chừng nước mưa hắt", desc: "Nguy hiểm đầu tiên là nước mưa hắt và dột từ mái hiên xuống. Giọt nước đọng trên ngọn, trên nách lá qua đêm chính là lúc nấm khuẩn tấn công. Sau mỗi cơn mưa hắt, bạn nên lắc nhẹ cho ráo nước đọng, hoặc dời cây vào sâu hơn khi trời mưa lớn, để cây không bị ngậm nước lâu." },
      { label: "Điều 2", title: "Giảm hẳn việc tưới nước", desc: "Mùa mưa độ ẩm không khí rất cao nên phải giảm hẳn việc tưới. Giá thể còn ẩm thì tuyệt đối đừng tưới thêm, vì tưới chồng lên phần ẩm sẵn chính là công thức gây thối rễ. Hãy thò tay kiểm tra gốc, chỉ tưới khi thấy giá thể đã se khô, đừng tưới theo thói quen mỗi ngày." },
      { label: "Điều 3", title: "Tăng gió cho mau khô lá", desc: "Gió chính là thuốc phòng bệnh tự nhiên. Hiên nhà mùa mưa hay tù đọng khí, nên hãy đặt thêm một chiếc quạt nhỏ cho không khí luân chuyển, giúp lá cây mau khô sau mưa. Khi giàn lan luôn thoáng gió thì nấm khuẩn rất khó lòng sinh sôi, cây khỏe hẳn mà không tốn nhiều công thuốc." },
      { label: "Điều 4", title: "Phòng bệnh định kỳ", desc: "Phòng bệnh định kỳ trong mùa mưa là điều bắt buộc. Cứ mười tới mười lăm ngày, hoặc ngay sau một đợt mưa dài, bạn nên phun luân phiên thuốc phòng nấm và phòng khuẩn. Đừng đợi cây có triệu chứng mới chữa, vì mùa mưa bệnh lây lan cực nhanh, nhiều khi không kịp trở tay cứu cây." },
    ],
    outroText: "Coi chừng nước mưa hắt, giảm tưới, tăng gió cho mau khô lá\nvà phòng bệnh định kỳ. Chủ động phòng thì mùa mưa không còn đáng sợ với lan hiên nhà.\nVườn hiên nhà bạn mùa mưa hay gặp bệnh gì? Comment nhé 👇",
  },
  {
    slug: "hienloai",
