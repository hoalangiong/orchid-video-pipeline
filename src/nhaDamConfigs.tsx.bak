  {
    slug: "aspirin",
    hideProduct: true,
    colors: { accent: "#d94f6c", gold: "#f5a3b5", sub: "#fadce2", badgeText: "#3a0812", bg: "#22060c", gradient: "34,6,12" },
    scenes: { title: 408, tip1: 407, tip2: 394, tip3: 368, tip4: 386, outro: 260 },
    titleText: "1 VIÊN ASPIRIN\nCỨU GIÒ LAN SẮP CHẾT",
    subText: "Viên thuốc rẻ tiền mà tăng đề kháng, bật mầm trở lại 💊",
    tips: [
      { label: "Vì sao", title: "Tăng đề kháng tự nhiên", desc: "Aspirin chứa acid salicylic, chính là hoạt chất mà cây tự sinh ra khi bị stress để kích hoạt hệ miễn dịch. Bổ sung từ bên ngoài vào giúp lan tăng sức đề kháng, chống chịu nấm khuẩn tốt hơn và hồi phục nhanh hơn sau mỗi lần tổn thương. Đây là cơ chế có cơ sở khoa học hẳn hoi." },
      { label: "Liều dùng", title: "1 viên 300mg cho 4-5 lít nước", desc: "Liều lượng là điều cực kỳ quan trọng. Chỉ dùng một viên aspirin loại ba trăm milligram hòa tan trong bốn tới năm lít nước. Pha đậm hơn là phản tác dụng, cháy rễ cháy lá ngay. Loãng đúng liều thì mới là liều thuốc bổ, còn quá tay một chút thôi là thành thuốc độc hại cây." },
      { label: "Cách dùng", title: "Phun và tưới 15-20 ngày/lần", desc: "Dùng dung dịch này phun ướt đều thân lá và tưới gốc, khoảng mười lăm tới hai mươi ngày một lần. Hợp nhất là lúc cây vừa qua bệnh, mới thay chậu, hoặc khi thời tiết trở mùa khiến cây dễ bị sốc và suy yếu. Đây là lúc cây cần được trợ sức để vượt qua giai đoạn khó." },
      { label: "Lưu ý", title: "Chỉ trợ sức, không chữa bệnh", desc: "Aspirin là để phòng và trợ sức, không phải thuốc chữa bệnh thần kỳ. Cây đang thối nhũn nặng thì vẫn phải cắt bỏ phần hư và dùng thuốc đặc trị. Đừng phụ thuộc hoàn toàn vào nó, hãy xem đây như một cách nâng cao đề kháng cho cả vườn lan của bạn được khỏe mạnh hơn." },
    ],
    outroText: "1 viên 300mg cho 4-5 lít nước, phun tưới 15-20 ngày một lần\nlúc cây suy hay trở mùa, và nhớ nó chỉ trợ sức chứ không chữa bệnh. Một viên thuốc quen mà là trợ thủ đắc lực.\nBạn có mẹo cứu lan suy nào hay? Comment chia sẻ nhé 👇",
  },
  {
    slug: "khongthom",
    hideProduct: true,
    colors: { accent: "#c98a3f", gold: "#f0cf88", sub: "#f8eed2", badgeText: "#332208", bg: "#1e1606", gradient: "30,22,6" },
    scenes: { title: 378, tip1: 348, tip2: 357, tip3: 386, tip4: 359, outro: 250 },
    titleText: "VÌ SAO LAN NHÀ BẠN\nNỞ MÀ KHÔNG THƠM?",
    subText: "Cùng loại đó, nhà người ta thơm ngát cả sân, nhà mình thì không 🌸",
    tips: [
      { label: "Điều 1", title: "Không phải loại nào cũng thơm", desc: "Đầu tiên phải hiểu, không phải loại lan nào cũng thơm, và loại có hương thì cũng chỉ tỏa mùi vào một khung giờ nhất định. Nhiều dòng chỉ thơm vào buổi sáng sớm hoặc chiều tối, còn giữa trưa nắng gắt lại gần như không có mùi gì. Biết đặc tính của giống là bước đầu tiên." },
      { label: "Điều 2", title: "Thiếu nắng làm hoa nhạt hương", desc: "Thiếu nắng là thủ phạm số một làm hoa nhạt hương. Cây trồng ở chỗ rợp bóng vẫn ra hoa nhưng tinh dầu tạo mùi không đủ tích lũy. Muốn hoa thơm đậm, cây phải được tắm đủ nắng sáng trong suốt quá trình nuôi nụ, thì hương thơm mới có đủ nguyên liệu để hình thành và tỏa ra." },
      { label: "Điều 3", title: "Đủ lân kali hoa mới thơm", desc: "Dinh dưỡng cũng quyết định độ thơm. Giai đoạn làm nụ mà thiếu lân và kali, hoa sẽ nở nhưng mỏng manh, nhạt màu và ít hương. Bổ sung đúng phân kích hoa giúp bông dày cánh, lên màu đẹp và tỏa hương rõ hơn hẳn. Cây được nuôi đủ chất thì bông nào cũng bền và thơm hơn." },
      { label: "Điều 4", title: "Chờ cây thuần khí hậu", desc: "Cuối cùng là độ thuần khí hậu. Cây mới mua từ vùng khác về thường phải qua một hai mùa mới quen được nắng gió nhà bạn và thơm đúng bản chất của nó. Hãy kiên nhẫn chăm đúng cách, rồi mùi hương thật của giống sẽ dần dần trở lại đúng như bạn mong đợi ban đầu." },
    ],
    outroText: "Không phải loại nào cũng thơm, thiếu nắng và thiếu lân kali làm\nhoa nhạt hương, và cây mới cần thời gian thuần khí hậu. Hoá ra lan không phải không thơm, mà mình chưa cho đủ điều kiện.\nGiò lan nhà bạn có thơm không? Comment loại nhé 👇",
  },
  {
    slug: "dauhieucuu",
    hideProduct: true,
    colors: { accent: "#d9663f", gold: "#f5b088", sub: "#fae4d4", badgeText: "#3a1408", bg: "#220e06", gradient: "34,14,6" },
    scenes: { title: 376, tip1: 404, tip2: 407, tip3: 406, tip4: 400, outro: 252 },
    titleText: "DẤU HIỆU LAN SẮP CHẾT\nPHẢI CỨU NGAY",
    subText: "Nhận ra trễ một hai ngày là mất trắng cả giò ⏰",
    tips: [
      { label: "Dấu hiệu 1", title: "Rễ nâu đen, mềm nhũn, hôi", desc: "Gốc và rễ chuyển màu nâu đen, bóp vào thấy mềm nhũn và có mùi hôi, đó là thối rễ do úng nước. Phải lôi cây ra khỏi giá thể ngay, cắt sạch phần thối tới chỗ mô còn xanh, bôi keo liền sẹo rồi trồng lại vào giá thể mới thật khô thoáng. Chậm ngày nào là mất thêm rễ ngày đó." },
      { label: "Dấu hiệu 2", title: "Lá nhũn nước loang cực nhanh", desc: "Trên lá xuất hiện vết nhũn nước lan rất nhanh, sáng một đốm chiều đã loang cả lá, đó là thối nhũn vi khuẩn, cực kỳ nguy hiểm. Phải cắt bỏ ngay phần bệnh, tách cây ra khỏi vườn và phun thuốc đặc trị khuẩn liền. Chậm một chút là lây lan ra cả giàn, không kịp trở tay cứu." },
      { label: "Dấu hiệu 3", title: "Lá teo nhăn dù tưới đều", desc: "Lá teo tóp, nhăn nheo dù bạn vẫn tưới đều, đó là dấu hiệu rễ đã hỏng không hút được nước, cây đang mất sức từ từ. Kiểm tra bộ rễ ngay, nếu hỏng thì xử lý như thối rễ và chăm phục hồi trong mát, giữ ẩm nhẹ cho cây nhú rễ mới. Đừng cố tưới nhiều hơn, càng úng càng nặng." },
      { label: "Dấu hiệu 4", title: "Thân tóp, vàng lá từ gốc lên", desc: "Thân tóp lại, lá vàng rụng dần từ gốc lên mà không phải mùa nghỉ, đó là cây đang kiệt sức nặng. Đừng bón phân lúc này, hãy đưa cây vào chỗ mát thoáng, chỉ giữ ẩm và dùng chất kích rễ liều nhẹ để cây gom sức hồi lại từ từ. Ép ăn lúc đang yếu chỉ làm cây suy thêm." },
    ],
    outroText: "Rễ thối nhũn, lá nhũn nước loang nhanh, lá teo nhăn hay thân\ntóp vàng lá, gặp là phải xử lý ngay. Cứu lan là cuộc đua với thời gian, phát hiện sớm là còn kịp.\nBạn từng cứu được giò lan nào sắp chết chưa? Comment kể lại nhé 👇",
  },
  {
    slug: "dotbien",
