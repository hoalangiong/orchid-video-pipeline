    scenes: { title: 403, tip1: 426, tip2: 461, tip3: 463, tip4: 453, outro: 394 },
    titleText: "NGỌC ĐIỂM\nRA HOA ĐÚNG TẾT",
    subText: "Lan Đai Châu thơm cả nhà, canh mãi hoa vẫn nở lệch 🌸",
    tips: [
      { label: "Điều 1", title: "Hiểu đặc tính cây", desc: "Ngọc Điểm là lan đơn thân, lá dày xếp hai bên như cái quạt, ra hoa mỗi năm một lần vào mùa xuân. Vòi hoa hình đuôi chồn nhú ra từ nách lá. Muốn hoa đúng Tết, phải nuôi cây thật sung khỏe từ trong năm đã." },
      { label: "Điều 2", title: "Nuôi sung trước, hãm sau", desc: "Trong năm, bón phân đều cho cây mập lá, nhiều rễ. Đến khoảng đầu mùa khô cuối năm, giảm dần phân đạm, tăng lân kali để cây chuyển sang làm nụ thay vì ra lá. Cây càng sung trước đó thì vòi hoa càng dài, càng sai bông." },
      { label: "Điều 3", title: "Tạo khô lạnh kích nụ", desc: "Ngọc Điểm cần tiết trời khô, mát của mùa đông để bật vòi hoa. Vào cuối năm, giảm nước rõ rệt, chỉ giữ ẩm nhẹ, cho cây đón khí lạnh. Chính chênh lệch khô lạnh này báo hiệu cho cây rằng đã đến lúc làm hoa đón xuân." },
      { label: "Điều 4", title: "Canh thời điểm giữ nụ", desc: "Khi vòi hoa đã nhú, tưới nước trở lại đều đặn để nuôi vòi. Nếu thấy hoa có xu hướng nở sớm thì để cây chỗ mát hơn cho chậm lại, còn muốn nhanh thì cho ấm và sáng hơn. Nhẹ nhàng điều chỉnh để hoa bung đúng mấy ngày Tết." },
    ],
    outroText: "Nuôi cây thật sung, cuối năm hãm đạm tăng lân kali,\ntạo khô lạnh kích nụ rồi canh nhiệt cho hoa nở đúng hẹn.\nNhà bạn có trồng Ngọc Điểm chơi Tết không? Comment nhé! 👇",
  },
  {
    slug: "hodiep",
