    scenes: { title: 397, tip1: 371, tip2: 371, tip3: 365, tip4: 371, outro: 219 },
    titleText: "LOẠI LAN DỄ SỐNG\nỞ HIÊN NHÀ ÍT NẮNG",
    subText: "Chọn sai dòng, chăm cách mấy cây cũng không ra hoa 🌸",
    tips: [
      { label: "Số 1", title: "Hồ điệp, quán quân chịu bóng", desc: "Hồ điệp là quán quân chịu bóng. Loài này ưa sáng dịu, gián tiếp, gặp nắng gắt lại cháy lá, nên hiên nhà mát mẻ chính là môi trường lý tưởng cho nó. Hoa hồ điệp bền cả tháng, dáng sang trọng, gần như sinh ra để trồng trong hiên và ban công, rất hợp người bận rộn ít thời gian." },
      { label: "Số 2", title: "Lan hài, ưa bóng mát", desc: "Lan hài cũng là loài rất ưa bóng mát. Vốn sống dưới tán rừng nên nó chịu được mức sáng thấp cực tốt, để ở hiên nhà là hợp. Hoa hài dáng lạ, độc đáo, lại giữ được rất lâu trên cây, đặc biệt thích hợp cho những người thích sưu tầm các loại lan khác biệt và ít đụng hàng." },
      { label: "Số 3", title: "Thêm hoàng thảo, giả hạc", desc: "Nếu hiên nhà có được chút nắng sớm, bạn có thể thêm dòng hoàng thảo lá mềm và một số giả hạc. Chúng cần sáng nhỉnh hơn hồ điệp, nên chỉ hợp treo ở mép hiên hứng nắng buổi sáng. Khi được sáng đủ, chúng vẫn cho những chùm hoa buông rất đẹp, làm hiên nhà rực rỡ hẳn lên." },
      { label: "Số 4", title: "Chịu bóng không phải không cần sáng", desc: "Dù chịu bóng tới đâu, không loài lan nào sống nổi trong bóng tối hoàn toàn. Chịu bóng chỉ có nghĩa là cần ít sáng, chứ không phải là không cần sáng. Bạn vẫn phải chọn góc hiên sáng nhất và thoáng gió nhất để đặt cây, thì cây mới thật sự khỏe và chịu ra hoa đều đặn." },
    ],
    outroText: "Hồ điệp và lan hài chịu bóng giỏi nhất, thêm hoàng thảo giả hạc\nnếu có nắng sớm, và nhớ chịu bóng không phải là không cần sáng. Chọn đúng dòng là hiên nhà cũng thành vườn lan.\nBạn muốn trồng loại nào ở hiên? Comment cho mình biết nhé 👇",
  },
  {
    slug: "nuocdua",
    hideProduct: true,
    colors: { accent: "#3fae86", gold: "#9fe6c4", sub: "#dcf5ea", badgeText: "#04291d", bg: "#08201a", gradient: "8,32,26" },
    scenes: { title: 376, tip1: 376, tip2: 362, tip3: 333, tip4: 342, outro: 252 },
    titleText: "TƯỚI LAN BẰNG NƯỚC DỪA\nRỄ BUNG TRẮNG NÕN",
    subText: "Thứ bỏ đi trong bếp mà dân chơi lan lâu năm giấu kín 🥥",
    tips: [
      { label: "Vì sao", title: "Kích rễ, đẩy mầm cực mạnh", desc: "Nước dừa giàu kích thích tố tự nhiên và khoáng chất, giúp lan bung rễ, đẩy mầm cực mạnh, đặc biệt hợp với cây mới ghép hay cây suy đang cần phục hồi. Đây là món bổ dưỡng gần như miễn phí mà rất nhiều người vô tình đổ bỏ mỗi ngày mà không hề hay biết." },
      { label: "Cách pha", title: "Pha loãng 1 dừa 5 nước", desc: "Phải dùng nước dừa tươi già, pha loãng với nước sạch theo tỷ lệ một phần dừa, năm phần nước. Tưới nguyên chất là quá đậm, đường nhiều nấm khuẩn kéo tới, gốc thối ngay lập tức. Loãng ra mà tưới đều đặn mới vừa an toàn lại vừa cho hiệu quả rõ rệt trên bộ rễ." },
      { label: "Tần suất", title: "10-15 ngày một lần, sáng sớm", desc: "Chỉ tưới nước dừa mười tới mười lăm ngày một lần, phun vào gốc và rễ vào lúc sáng sớm. Đừng lạm dụng tưới liên tục, cây không hấp thụ kịp, phần dư thừa đọng lại chính là môi trường lý tưởng cho nấm bệnh sinh sôi và phá hỏng bộ rễ khỏe mạnh của cây." },
      { label: "Lưu ý", title: "Thoáng gió, tránh cây bệnh", desc: "Sau khi tưới nước dừa, phải đặt cây ở chỗ thật thoáng gió cho nhanh khô. Tuyệt đối không dùng cho cây đang bị bệnh, đang thối nhũn, vì lúc đó chất dinh dưỡng chỉ nuôi thêm vi khuẩn, làm cây chết nhanh hơn. Nước dừa là để bồi bổ cho cây khỏe, không phải thuốc chữa bệnh." },
    ],
    outroText: "Nước dừa tươi già pha loãng 1 với 5, tưới 10-15 ngày một lần\nlúc sáng sớm, thoáng gió và tránh cây bệnh. Một mẹo nhỏ từ thứ bỏ đi mà cho hiệu quả bất ngờ.\nBạn đã thử tưới lan bằng nước dừa chưa? Comment cho mình biết nhé 👇",
