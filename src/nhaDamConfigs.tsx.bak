    colors: { accent: "#8f6bd9", gold: "#c3a8f5", sub: "#e8dcfa", badgeText: "#1e0838", bg: "#120622", gradient: "18,6,34" },
    scenes: { title: 402, tip1: 376, tip2: 417, tip3: 403, tip4: 427, outro: 250 },
    titleText: "SỰ THẬT VỀ CƠN SỐT\nLAN ĐỘT BIẾN BẠC TỶ",
    subText: "Từng hét giá cả tỷ đồng, rồi bong bóng vỡ, bao người trắng tay 💸",
    tips: [
      { label: "Bản chất", title: "Đột biến gen là có thật", desc: "Lan đột biến, hay còn gọi là lan var, thực chất là cây có gen biến đổi tự nhiên cho ra mặt hoa khác lạ, thường là đột biến màu trắng tinh trên nền loài giả hạc. Về bản chất sinh học, đây là một hiện tượng hoàn toàn có thật trong tự nhiên, không phải trò lừa đảo gì cả." },
      { label: "Cơn sốt", title: "Giá bạc tỷ là do thổi giá", desc: "Nhưng cái giá bạc tỷ ngày xưa phần lớn là do thổi giá mà ra. Người ta mua đi bán lại một mầm nhỏ với giá trên trời, tạo ra một cơn sốt ảo. Khi không còn người mua sau chịu ôm hàng nữa, bong bóng vỡ, giá rơi tự do, và người vào sau cùng chính là người chịu thiệt hại nặng nhất." },
      { label: "Bài học", title: "Đừng coi lan là kênh làm giàu", desc: "Bài học lớn nhất là đừng bao giờ coi lan như một kênh đầu tư làm giàu nhanh. Hãy chơi lan vì yêu cái đẹp của nó. Một mặt hoa đột biến trắng muốt vẫn rất đáng để ngắm, nhưng hãy mua với giá trị thật của một cái cây, chứ không phải mua bằng cái giá của lòng tham con người." },
      { label: "Bây giờ", title: "Giá đã về mặt đất, ai cũng chơi được", desc: "Giờ đây giá lan var đã về mặt đất, nhiều mặt hoa đẹp giá chỉ còn vài trăm nghìn, ai cũng có thể chơi được. Nếu thích, cứ chọn cây khỏe, nguồn gốc rõ ràng và hợp túi tiền mà thưởng thức. Đẹp hay không là nằm ở người ngắm, chứ không nằm ở cái giá tiền của cây." },
    ],
    outroText: "Đột biến là có thật, nhưng giá bạc tỷ chỉ là thổi giá, đừng coi\nlan là kênh làm giàu, giờ giá đã về mặt đất ai cũng chơi được. Cơn sốt nào rồi cũng qua, chỉ tình yêu với hoa là ở lại.\nBạn nghĩ sao về lan đột biến bây giờ? Comment nhé 👇",
