    scenes: { title: 427, tip1: 463, tip2: 430, tip3: 440, tip4: 457, outro: 399 },
    titleText: "GHÉP LAN LÊN\nGỖ, LŨA HAY DỚN",
    subText: "Chọn sai giá thể là cây còi cọc, khó ra hoa 🪵",
    tips: [
      { label: "Điều 1", title: "Ghép lên gỗ", desc: "Gỗ nhãn, gỗ vú sữa rất bền, thoáng, hợp các loại lan thân thòng như giả hạc. Rễ bám chắc, cây khỏe, ra hoa đẹp. Nhược điểm là gỗ giữ ẩm kém nên mùa khô phải tưới nhiều hơn, và cây con mới ghép cần thời gian bám." },
      { label: "Điều 2", title: "Ghép lên lũa", desc: "Lũa là gỗ đã mục hết phần mềm, cực bền, dáng đẹp như một tác phẩm. Rất thoáng, gần như không giữ ẩm nên hợp lan ưa khô thoáng và người chơi thích thế nghệ thuật. Bù lại phải tưới chăm hơn và cây lâu phủ hơn so với dớn." },
      { label: "Điều 3", title: "Ghép lên dớn", desc: "Dớn giữ ẩm tốt, cây nhanh ra rễ, nhanh phủ, rất hợp người mới và khí hậu khô nóng. Nhược điểm là dớn giữ ẩm nhiều nên dễ đọng nước gây thối nếu tưới ẩu, và dớn sẽ mục dần theo thời gian, vài năm phải thay." },
      { label: "Điều 4", title: "Chọn theo điều kiện", desc: "Vườn nắng gió nhiều, tưới được thường xuyên thì gỗ và lũa cho cây bền, hoa đẹp. Ban công khô nóng, ít thời gian tưới thì dớn giữ ẩm là an toàn. Quan trọng nhất, giá thể nào cũng phải sạch và thật thoáng ở gốc." },
    ],
    outroText: "Gỗ và lũa bền, thoáng, hoa đẹp nhưng cần tưới nhiều.\nDớn giữ ẩm, nhanh phủ, hợp người mới. Chọn theo vườn của bạn.\nBạn đang ghép lan lên giá thể gì? Comment nhé! 👇",
  },
  {
    slug: "ngocdiem",
