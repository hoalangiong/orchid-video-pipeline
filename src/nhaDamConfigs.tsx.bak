    scenes: { title: 443, tip1: 561, tip2: 544, tip3: 553, tip4: 556, outro: 453 },
    titleText: "VỎ TRỨNG VỎ CHUỐI BÓN LAN\nCỨNG CÂY SAI HOA",
    subText: "Kho canxi kali quý bạn vứt đi, nhưng bỏ nguyên vào chậu là sai 🥚",
    tips: [
      { label: "Điều 1", title: "Vỏ trứng vỏ chuối bổ gì cho lan", desc: "Vỏ trứng giàu canxi, giúp thành tế bào chắc khỏe, cây cứng cáp, ít gãy đổ, hoa lâu tàn. Vỏ chuối giàu kali và lân, kích ra hoa, giúp bông to, màu đậm, bền. Hai thứ bỏ đi này kết hợp lại là nguồn khoáng tự nhiên tuyệt vời để dưỡng lan vào giai đoạn làm nụ, nuôi hoa." },
      { label: "Điều 2", title: "Sai lầm khi bỏ nguyên vỏ vào chậu", desc: "Rất nhiều người tiện tay nhét thẳng vỏ chuối, vỏ trứng vào gốc lan. Đây là sai lầm tai hại, vì vỏ tươi phân hủy chậm, bốc mùi, hút ruồi kiến, sinh nấm mốc và làm úng thối gốc. Muốn dùng an toàn thì phải sơ chế, chứ không phải cứ đồ bổ là quăng đại vào là cây tốt." },
      { label: "Điều 3", title: "Sơ chế vỏ trứng đúng chuẩn", desc: "Rửa sạch vỏ trứng, phơi khô rồi giã hoặc xay thật mịn thành bột. Bột càng mịn canxi càng dễ tan, cây hấp thu nhanh. Mỗi lần chỉ rắc một chút bột quanh giá thể, hoặc ngâm bột vào nước tưới rồi lọc lấy nước. Làm vậy vừa sạch sẽ, vừa nhả khoáng từ từ, không hại rễ." },
      { label: "Điều 4", title: "Ngâm ủ vỏ chuối lấy nước tưới", desc: "Với vỏ chuối, hãy cắt nhỏ, ngâm vào nước hoặc ủ với men vi sinh chừng một tới hai tuần cho phân hủy, rồi lọc lấy nước, pha thật loãng để tưới quanh gốc. Tuyệt đối không tưới nước ủ đặc và đừng để dính lên hoa. Tưới định kỳ trước mùa ra hoa là bông sẽ to, sắc lên trông thấy." },
    ],
    outroText: "Hiểu vỏ trứng cho canxi vỏ chuối cho kali, tránh bỏ nguyên vỏ\nvào gốc, giã mịn vỏ trứng và ngâm ủ vỏ chuối pha loãng mà tưới. Vậy là lan sai hoa.\nBạn từng tận dụng vỏ trứng vỏ chuối cho lan chưa? Comment cho mình biết nhé 👇",
  },
