    scenes: { title: 450, tip1: 521, tip2: 515, tip3: 519, tip4: 511, outro: 406 },
    titleText: "KIẾN LÀM TỔ TRONG CHẬU\nĐUỔI SẠCH KHÔNG HẠI LAN",
    subText: "Kẻ phá ngầm cắn nát rễ non, tha rệp về nuôi 🐜",
    tips: [
      { label: "Điều 1", title: "Vì sao phải đuổi kiến", desc: "Kiến làm tổ trong chậu tha đất cát bịt kín giá thể, gây bí úng, lại cắn phá đầu rễ non khiến cây khựng lại. Nguy hơn, kiến còn chăn nuôi rệp sáp, rệp vảy để hút mật, khiến nạn rệp bùng phát. Thấy kiến đi lại tấp nập trên giò là phải xử lý ngay, đừng chủ quan." },
      { label: "Điều 2", title: "Ngâm chậu để đuổi tổ kiến", desc: "Cách nhanh và an toàn nhất là nhúng cả chậu vào chậu nước sạch chừng mười tới mười lăm phút. Kiến ngộp nước sẽ tự bò ra hết, trứng và tổ cũng trôi đi. Với giò treo thì tưới đẫm nhiều lần cho sũng giá thể. Cách này sạch kiến mà không cần một giọt hóa chất nào." },
      { label: "Điều 3", title: "Cắt đường tiếp tế của kiến", desc: "Kiến theo dây treo, theo trụ giàn mà lên. Hãy bôi một vòng vaseline hoặc mỡ trơn quanh dây, quanh chân trụ để chặn lối đi. Có thể treo chậu cách biệt, kê chân giàn vào bát nước. Cắt đứt đường lên là kiến không tái lập tổ được nữa, giò lan yên ổn dài lâu." },
      { label: "Điều 4", title: "Xử lý tận gốc và phòng rệp", desc: "Nếu kiến quá nhiều, có thể rắc phấn diệt kiến quanh chân giàn, tránh rắc thẳng vào gốc lan. Song song đó phải diệt luôn rệp sáp mà kiến nuôi, bằng dung dịch ớt tỏi gừng hoặc thuốc chuyên dụng. Hết rệp thì kiến cũng hết lý do kéo tới, giải quyết cả gốc lẫn ngọn." },
    ],
    outroText: "Hiểu tác hại của kiến, ngâm chậu đuổi tổ, bôi trơn cắt đường\ntiếp tế và diệt luôn rệp sáp. Làm vậy là chậu lan sạch kiến, rễ non bung khỏe.\nGiàn lan nhà bạn có hay bị kiến làm tổ không? Comment cho mình biết nhé 👇",
