    tips: [
      { label: "Điều 1", title: "Dưỡng cây sung sức trước", desc: "Muốn ra hoa đều thì trước hết cả giàn phải khỏe ngang nhau. Vài tháng trước vụ, bón phân cân đối, đủ nắng nước để giả hành mập, thân lá sung. Cây yếu thì có kích cũng không nở. Nền cây đồng đều, sung sức là điều kiện đầu tiên để hoa bung cùng lúc." },
      { label: "Điều 2", title: "Chuyển phân đón hoa", desc: "Khi cây đã sung, ngừng phân đạm cao, chuyển sang phân giàu lân và kali để cây chuyển từ nuôi thân sang làm nụ. Phun loại kích hoa lân kali cao đều tay cho cả giàn trong vài tuần. Đổi công thức phân đồng loạt là tín hiệu cho cả vườn cùng chuyển sang làm hoa." },
      { label: "Điều 3", title: "Tạo cú kích khô hạn, lạnh", desc: "Nhiều dòng lan cần một cú sốc nhẹ để bung nụ. Siết nước vài ngày cho hơi khô, hoặc tận dụng đợt se lạnh cuối năm, chênh lệch nhiệt ngày đêm sẽ thúc cây phân hóa mầm hoa. Cho cả giàn cùng chịu một điều kiện là chúng cùng nhận tín hiệu ra hoa." },
      { label: "Điều 4", title: "Canh thời gian, giữ đều tay", desc: "Mỗi dòng lan tính từ lúc nhú vòi tới nở mất số tuần khác nhau, nên đếm ngược từ ngày muốn hoa để bắt đầu kích cho đúng. Quan trọng nhất là làm đồng loạt cả giàn, cùng lịch tưới, cùng lịch phân. Đều tay và đúng thời điểm là hoa nở rộ cùng nhau." },
    ],
    outroText: "Dưỡng cây sung đều, chuyển phân đón hoa, tạo cú kích\nrồi canh đúng thời gian cho cả giàn là cả vườn bung hoa đồng loạt.\nBạn muốn canh lan nở đúng dịp nào? Comment nhé! 👇",
  },
  {
    slug: "nammua",
    hideProduct: true,
    colors: { accent: "#5aa9c8", gold: "#a9dcef", sub: "#e0f2fa", badgeText: "#0a2833", bg: "#0a1820", gradient: "10,24,32" },
    scenes: { title: 430, tip1: 467, tip2: 468, tip3: 499, tip4: 492, outro: 428 },
    titleText: "TRỊ NẤM BỆNH\nMÙA MƯA CHO LAN",
    subText: "Mưa dầm vài hôm là thối nhũn lan cả giàn, biết cách là chặn đứng 🌧️",
    tips: [
      { label: "Điều 1", title: "Nhận đúng mặt bệnh", desc: "Thối nhũn do vi khuẩn thì vết mềm nhũn, chảy nước, hôi và lan cực nhanh. Thán thư, đốm lá do nấm thì vết khô hơn, đốm tròn nâu đen loang dần. Nhận đúng nấm hay khuẩn mới chọn đúng thuốc, vì thuốc trị nấm không diệt được khuẩn và ngược lại." },
      { label: "Điều 2", title: "Cách ly, cắt bỏ phần bệnh", desc: "Thấy cây bệnh phải tách riêng khỏi giàn liền để khỏi lây. Dùng kéo, dao khử trùng cắt bỏ hết phần lá thân đã thối đốm, cắt lẹm vào phần còn xanh một chút. Bôi vôi hay keo liền sẹo vào vết cắt. Cắt sạch nguồn bệnh là chặn được đà lây lan." },
      { label: "Điều 3", title: "Phun thuốc đúng loại", desc: "Bệnh do khuẩn thì dùng thuốc gốc đồng hoặc kháng sinh nông nghiệp. Bệnh do nấm thì dùng thuốc trị nấm phổ rộng. Phun ướt đều cả cây và cây xung quanh, lặp lại theo hướng dẫn vài lần cách nhau ít ngày. Đúng thuốc, đủ liều, đủ đợt là bệnh mới dứt hẳn." },
      { label: "Điều 4", title: "Phòng bệnh mới là gốc", desc: "Mùa mưa phải để giàn thật thoáng gió, giãn chậu cho khỏi chen chúc, che bớt mưa dầm trực tiếp. Hạn chế tưới chiều tối để lá khô ráo qua đêm. Định kỳ phun phòng nấm khuẩn và trộn nấm đối kháng trichoderma. Giàn khô thoáng là nấm khuẩn hết đường bùng." },
    ],
    outroText: "Nhận đúng mặt bệnh, cách ly cắt bỏ phần thối, phun đúng thuốc\nrồi giữ giàn khô thoáng để phòng là cả vườn vượt mùa mưa an toàn.\nMùa mưa vườn bạn hay bị bệnh gì? Comment nhé! 👇",
  },
  {
    slug: "chongiathe",
