    scenes: { title: 269, tip1: 233, tip2: 236, tip3: 243, tip4: 241, outro: 277 },
    titleText: "AI CẮN CỤT NỤ HOA LAN?\nTHỦ PHẠM LÀ ỐC SÊN",
    subText: "Xịt thuốc sâu mãi không hết vì bắt nhầm bệnh 🐌",
    tips: [
