    colors: { accent: "#3fae7a", gold: "#b6f0d5", sub: "#d8fbec", badgeText: "#0a2e1e", bg: "#081510", gradient: "10,26,20" },
    scenes: { title: 342, tip1: 415, tip2: 389, tip3: 367, tip4: 396, outro: 414 },
    titleText: "PHÒNG TRỊ THỐI NHŨN,\nĐỐM LÁ CHO LAN",
    subText: "Chiều còn xanh, sáng ra đã nhũn cả giò 🌿",
    tips: [
      { label: "Điều 1", title: "Đọc đúng bệnh", desc: "Thối nhũn do vi khuẩn thì mềm nước, nhớt và có mùi hôi, lan cực nhanh. Đốm lá do nấm thì khô hơn, thành vệt nâu đen có viền. Nhìn đúng bệnh mới chọn đúng thuốc, chữa sai là cây chết oan." },
      { label: "Điều 2", title: "Cách ly và cắt bỏ", desc: "Tách ngay cây bệnh khỏi giàn để không lây. Dùng dao lam sạch cắt hết phần nhũn, cắt lấn sang cả phần lành. Sau mỗi nhát cắt phải khử trùng lưỡi dao, tránh chính tay mình mang bệnh đi khắp vườn." },
      { label: "Điều 3", title: "Phun đúng thuốc", desc: "Thối nhũn vi khuẩn thì dùng thuốc gốc đồng hoặc kháng sinh nông nghiệp. Đốm lá do nấm thì dùng thuốc trừ nấm. Bôi keo hoặc thuốc vào vết cắt, để cây nơi khô thoáng cho vết thương se lại." },
      { label: "Điều 4", title: "Phòng hơn chữa", desc: "Giàn phải thông thoáng, thoát nước tốt, không để cây sát nhau bí gió. Tưới vào sáng sớm cho cây kịp khô trước đêm. Định kỳ phun phòng nấm khuẩn và giữ vệ sinh, bệnh sẽ không có cửa bùng lên." },
    ],
    outroText: "Nhận đúng bệnh, cách ly, cắt sạch, phun đúng thuốc,\nvà quan trọng nhất là phòng từ sớm, giữ giàn thoáng.\nBạn hay gặp bệnh gì trên lan? Comment nhé! 👇",
  },
  {
    slug: "bonphan",
    hideProduct: true,
    colors: { accent: "#5ba32f", gold: "#c8ea9e", sub: "#e4f7d1", badgeText: "#15330a", bg: "#0b1705", gradient: "11,23,5" },
    scenes: { title: 365, tip1: 357, tip2: 374, tip3: 380, tip4: 390, outro: 404 },
    titleText: "BÓN PHÂN CHO LAN\nTHEO TỪNG MÙA",
    subText: "Bón đúng thì hoa sai, bón sai thì cháy rễ 🌿",
    tips: [
      { label: "Giai đoạn 1", title: "Nuôi thân, nuôi lá", desc: "Khi cây đang lên mầm, ra thân non, dùng phân đạm cao như ba mươi mười mười. Đạm giúp cây phát triển thân lá mạnh mẽ, tạo bộ khung khỏe làm nền cho cả mùa hoa sắp tới." },
      { label: "Giai đoạn 2", title: "Dưỡng cây trưởng thành", desc: "Khi thân đã lớn ổn định, chuyển sang phân cân bằng như hai mươi hai mươi hai mươi. Bón cân đối giúp cây tích lũy đầy đủ dưỡng chất, sung sức chuẩn bị cho bước phân hóa mầm hoa." },
      { label: "Giai đoạn 3", title: "Kích ra hoa", desc: "Khi cây thắt ngọn, hạ phân đạm và tăng lân kali như sáu ba mươi ba mươi. Lân kali thúc cây chuyển từ nuôi lá sang làm nụ, cho vòi hoa mập, hoa bền màu và lâu tàn hơn hẳn." },
      { label: "Nguyên tắc vàng", title: "Loãng và đều", desc: "Thà bón loãng nhiều lần còn hơn đặc một lần gây cháy rễ. Tưới nước trước khi bón, phun vào sáng sớm hoặc chiều mát. Kết hợp thêm phân hữu cơ như dịch chuối để cây khỏe bền, ít bệnh." },
    ],
    outroText: "Đạm nuôi thân lá, cân bằng dưỡng cây, lân kali kích hoa,\nvà luôn bón loãng nhiều lần, đúng phân đúng lúc cây tự sai hoa.\nBạn đang dùng phân gì cho lan? Comment nhé! 👇",
  },
  {
    slug: "kichki",
    hideProduct: true,
    colors: { accent: "#6bbf3a", gold: "#cef0a3", sub: "#e8fbcf", badgeText: "#1a3300", bg: "#0d1500", gradient: "16,26,0" },
    scenes: { title: 366, tip1: 392, tip2: 383, tip3: 402, tip4: 396, outro: 384 },
    titleText: "KÍCH KI, NHÂN GIỐNG\nGIẢ HẠC TẠI NHÀ",
    subText: "Một thân già cho cả chục cây con giống cây mẹ 🌿",
    tips: [
      { label: "Bước 1", title: "Chọn thân làm giống", desc: "Chọn thân già đã rụng lá nhưng còn chắc, còn nhiều mắt ngủ ở các đốt. Thân càng mập, tích nhiều dinh dưỡng thì càng nuôi ki khỏe. Cắt thành đoạn hoặc để nguyên treo đều được." },
      { label: "Bước 2", title: "Đánh thức mắt ngủ", desc: "Bôi keo kích ki vào mắt ngủ ở các đốt thân. Loại keo này chứa chất kích thích giúp mắt ngủ bật thành cây con thay vì nằm im. Bôi mỏng, đúng vào mắt, tránh bôi lan ra cả thân." },
      { label: "Bước 3", title: "Giữ ẩm chờ ki", desc: "Đặt thân nơi ẩm, mát, thoáng, tránh nắng gắt. Phun sương giữ ẩm đều đặn. Sau ít tuần, mắt ngủ sẽ nhú mầm xanh rồi thành cây con nhỏ, gọi là ki, mọc ngay trên thân mẹ." },
      { label: "Bước 4", title: "Tách ki ươm cây", desc: "Khi ki đã ra hai ba lá và bộ rễ dài vài phân, nhẹ nhàng tách khỏi thân mẹ. Ghép ki lên giá thể ẩm, dưỡng nơi mát cho rễ bám. Vậy là từ một thân già bạn đã có lứa cây con mới." },
    ],
    outroText: "Chọn thân già khỏe, bôi keo mắt ngủ, giữ ẩm chờ ki rồi tách ươm,\nbốn bước nhân giống giả hạc ai cũng làm được tại nhà.\nBạn đã thử kích ki bao giờ chưa? Comment nhé! 👇",
  },
  {
    slug: "cattia",
    hideProduct: true,
    colors: { accent: "#d98a3f", gold: "#f2cfa3", sub: "#fae9d4", badgeText: "#3a1e07", bg: "#170f05", gradient: "23,15,5" },
    scenes: { title: 383, tip1: 385, tip2: 388, tip3: 419, tip4: 419, outro: 434 },
    titleText: "CẮT TỈA GIẢ HẠC\nSAU KHI HOA TÀN",
    subText: "Để nguyên vòi khô, cây kiệt sức năm sau chẳng ra hoa 🌸",
    tips: [
      { label: "Điều 1", title: "Nhận biết hoa tàn", desc: "Khi những bông cuối trên vòi đã héo, rụng gần hết, đó là lúc cây chuyển sang giai đoạn dưỡng thân. Đừng tiếc mấy bông cuối, để vòi khô lâu trên cây chỉ khiến cây hao sức vô ích." },
      { label: "Điều 2", title: "Cắt vòi đúng cách", desc: "Dùng kéo hoặc dao lam sạch đã khử trùng, cắt sát cuống vòi hoa đã tàn, tránh cắt phạm vào thân. Cắt gọn giúp cây ngừng dồn sức nuôi hoa tàn, chuyển năng lượng về nuôi thân và mắt ngủ." },
      { label: "Điều 3", title: "Dưỡng thân tích sức", desc: "Sau khi cắt vòi, giảm nước một chút và bổ sung phân cân bằng loãng cho cây phục hồi. Giai đoạn này thân sẽ mập lại, mắt ngủ ở gốc tích đủ dinh dưỡng, chuẩn bị cho lứa mầm và hoa mùa sau." },
      { label: "Điều 4", title: "Để cây nghỉ ngơi", desc: "Đặt cây nơi thoáng mát, ánh sáng dịu, tưới vừa phải. Đừng vội thúc phân đạm mạnh ngay. Cho cây một khoảng nghỉ để lại sức, rồi mới bước vào chu kỳ nuôi thân mới, cây sẽ khỏe và bền hơn nhiều." },
    ],
    outroText: "Nhận biết hoa tàn, cắt vòi gọn, dưỡng thân rồi cho cây nghỉ,\nbốn bước giúp giả hạc hồi sức sau mùa hoa.\nGiả hạc nhà bạn vừa tàn hoa chưa? Comment nhé! 👇",
  },
  {
    slug: "nhanang",
    hideProduct: true,
    colors: { accent: "#e0b53c", gold: "#f5e2a0", sub: "#fbf3d4", badgeText: "#3a2e07", bg: "#161305", gradient: "22,19,5" },
    scenes: { title: 400, tip1: 435, tip2: 435, tip3: 421, tip4: 412, outro: 362 },
    titleText: "NHẬN BIẾT LAN\nĐỦ HAY THIẾU NẮNG",
    subText: "Nhìn lá là biết cây đang thừa hay thiếu nắng ☀️",
    tips: [
      { label: "Điều 1", title: "Dấu hiệu thiếu nắng", desc: "Lan thiếu sáng thì lá xanh đậm bất thường, mềm và mỏng, thân vươn dài ẻo lả. Cây tốt lá nhưng yếu, khó ra hoa vì không tích đủ năng lượng. Xanh mướt quá mức không phải lúc nào cũng là dấu hiệu khỏe." },
      { label: "Điều 2", title: "Dấu hiệu đủ nắng", desc: "Lan đủ sáng thì lá có màu xanh hơi ngả vàng, dày và cứng cáp, thân mập chắc. Đây là trạng thái lý tưởng, cây tích đủ năng lượng để phân hóa mầm hoa. Màu lá hơi vàng nhạt chính là màu của cây sung sức." },
      { label: "Điều 3", title: "Dấu hiệu thừa nắng", desc: "Nắng quá gắt thì lá xuất hiện vệt cháy nâu khô, hoặc vàng loang rồi rám lại. Lá có thể nhăn, teo vì mất nước. Thấy dấu hiệu này phải che bớt nắng ngay, kẻo cây suy và dễ nhiễm bệnh qua vết cháy." },
      { label: "Điều 4", title: "Điều chỉnh giàn", desc: "Thiếu nắng thì đưa cây ra chỗ sáng hơn hoặc bớt lớp lưới. Thừa nắng thì tăng lớp lưới che, treo cây cao thoáng, dời khỏi nắng trưa gắt. Quan sát lá vài tuần rồi chỉnh dần, đừng thay đổi đột ngột khiến cây sốc." },
    ],
    outroText: "Lá xanh đậm mềm là thiếu, xanh ngả vàng dày cứng là đủ, cháy rám là thừa,\nnhìn lá mà chỉnh giàn thì cây khỏe và sai hoa.\nLá lan nhà bạn đang màu gì? Comment nhé! 👇",
  },
  {
