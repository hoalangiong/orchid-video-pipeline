    scenes: { title: 471, tip1: 577, tip2: 527, tip3: 567, tip4: 523, outro: 423 },
    titleText: "DẤU HIỆU BẠN ĐANG TƯỚI SAI\nÂM THẦM GIẾT CHẾT LAN",
    subText: "Phần lớn lan chết không phải vì thiếu nước, mà vì bị tưới sai 💧",
    tips: [
      { label: "Điều 1", title: "Tưới quá nhiều, giá thể luôn sũng", desc: "Đây là lỗi phổ biến nhất. Lan cần ẩm nhưng ghét úng, rễ ngâm nước lâu sẽ thiếu oxy, thối đen, cây không hút được dinh dưỡng rồi lụi. Dấu hiệu là giá thể luôn ướt nhẹp, gốc mềm nhũn, lá vàng từ dưới lên. Hãy để giá thể se gần khô rồi mới tưới lại, đừng thấy trống là tưới." },
      { label: "Điều 2", title: "Tưới sai thời điểm trong ngày", desc: "Tưới giữa trưa nắng gắt làm cây sốc nhiệt, nước nóng lên hại rễ. Tưới quá muộn buổi tối khiến ngọn và lá đọng nước qua đêm, sinh nấm thối ngọn. Thời điểm tốt nhất là sáng sớm, để cây có cả ngày khô ráo, và nếu cần thì tưới thêm lúc chiều mát cho kịp ráo trước đêm." },
      { label: "Điều 3", title: "Tưới hời hợt, chỉ ướt bề mặt", desc: "Nhiều người tưới lướt qua cho có, nước chưa kịp ngấm vào lõi giá thể và bộ rễ bên trong. Bên ngoài trông ẩm nhưng rễ sâu vẫn khát. Khi tưới hãy tưới đẫm, tưới đi tưới lại vài lượt cho nước ngấm đều toàn bộ chậu, thấy nước chảy ra dưới đáy mới đủ. Đừng tưới cho có lệ." },
      { label: "Điều 4", title: "Dùng nguồn nước không phù hợp", desc: "Nước quá mặn, nhiễm phèn, hay nước máy nặng clo tưới lâu ngày sẽ tích muối, cháy đầu rễ, chột ngọn. Nếu nghi ngờ, hãy để nước máy lắng bay clo, hoặc ưu tiên nước mưa, nước lọc sạch. Nước tốt cộng cách tưới đúng mới nuôi được bộ rễ khỏe, mà rễ khỏe thì cây mới sung." },
    ],
    outroText: "Đừng tưới khi giá thể còn sũng, tránh tưới trưa nắng và tối\nmuộn, đã tưới thì tưới đẫm cho ngấm, và chọn nguồn nước sạch. Sửa bốn lỗi này là lan hết chết oan vì tưới sai.\nBạn hay tưới lan vào lúc nào trong ngày? Comment cho mình biết nhé 👇",
  },
  {
    slug: "maiton",
